{
  "name": "iris-bay-bloom-for-you",
  "version": "3.0.0",
  "private": true,
  "description": "《鸢尾湾·花与海之约》 — 海景花墅、莫奈花园与群岛海湾庄园 (Babylon.js 9 + 二次元 Cel 着色 + Blender 骨骼/精雕模型)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-single-html.mjs",
    "build:web": "vite build",
    "build:single": "node scripts/build-single-html.mjs",
    "preview": "vite preview --port 4173",
    "test": "python3 -m unittest discover -s tests -v",
    "test:e2e": "python3 tests/verify_e2e_playwright.py",
    "optimize:glbs": "python3 tools/optimize_glbs.py"
  },
  "dependencies": {
    "@babylonjs/core": "9.36.0",
    "@babylonjs/loaders": "9.36.0",
    "@babylonjs/materials": "9.36.0"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
